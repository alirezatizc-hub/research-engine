# ─────────────────────────────────────────────────────────────────────────────
# نمونهٔ تنظیمات. این فایل را به .env کپی کنید و مقادیر را پر کنید.
# .env هرگز نباید در گیت ذخیره شود (در .gitignore هست).
# توجه: پنل UI تنظیمات را در همین فایل .env می‌نویسد؛ برای اجرای پنل، از ریشهٔ
# پروژه (wallex-ai-trader) اجرا کنید تا مسیرها یکی باشند.
# ─────────────────────────────────────────────────────────────────────────────

# --- کلیدها (فقط در محیط خودتان) ---
WALLEX_API_KEY=
# کلید عامل AI؛ برای Anthropic یا هر سرویس سازگار با OpenAI
WTB_AI_API_KEY=
WTB_AI_PROVIDER=anthropic          # anthropic | openai
WTB_AI_MODEL=claude-sonnet-5-5
# برای سرویس سازگار با OpenAI (OpenRouter، AvalAI، Ollama و …) آدرس پایه را بدهید
# WTB_AI_BASE_URL=https://openrouter.ai/api/v1
# WTB_AI_MODEL=anthropic/claude-sonnet-5-5

# --- حساب فرعی/هدر اختصاصی (در صورت نیاز؛ JSON) ---
# WTB_EXTRA_HEADERS={"X-Sub-Account-Id":"..."}

# --- اجباری برای live (دروازه بدون این‌ها باز نمی‌شود) ---
WTB_SYMBOLS=BTCTMN,ETHTMN,SOLTMN,XRPTMN,DOGETMN,TRXTMN,ADATMN,BNBTMN
WTB_MAX_DRAWDOWN=0.05               # سقف افت از اوج؛ انتخاب خودتان را آگاهانه ثبت کنید
WTB_DAILY_LOSS_LIMIT=0.025          # باید کمتر از max_drawdown باشد
WTB_CHALLENGE_END=2026-10-23T23:50:00+03:30   # پایان پنجرهٔ معاملات (به وقت تهران)
WTB_LIVE_ACK=                      # خروجی `python -m wallexbot params`

# --- ریسک و اندازهٔ پوزیشن ---
WTB_MAX_POSITIONS=3
WTB_MAX_POS_FRAC=0.25
WTB_RESERVE_FRAC=0.10
WTB_MAX_EXPOSURE_FRAC=0.75
WTB_RISK_PER_TRADE=0.008
WTB_MAX_TRADES_PER_DAY=20

# --- سیگنال و خروج (هزینه‌محور) ---
# ATR% واقعی ۱۵ دقیقه‌ای در دادهٔ نمونه ۰٫۲۰–۰٫۳۷٪ بود؛ ۰٫۲۵٪ حداقل معقول با کارمزد ۰٫۳۵٪
WTB_MIN_ATR_PCT=0.0025
WTB_RSI_BUY=45
WTB_BB_MAX_POS=0.30
WTB_MIN_SCORE=55
WTB_RULES_MIN_SCORE=55
WTB_SL_ATR=2.5
WTB_TP_ATR=5.0
WTB_SL_MIN=0.030
WTB_SL_MAX=0.060
WTB_TP_MIN=0.060
WTB_TRAIL_ACTIVATE=0.040
WTB_TRAIL_DIST=0.025
WTB_MAX_HOLD_H=48
WTB_COOLDOWN_MIN=30

# --- هزینه‌ها (در live با taker واقعی جایگزین می‌شود) ---
WTB_FEE_RATE=0.0035
WTB_SLIPPAGE=0.0010

# --- AI / MCP ---
WTB_AI_ENABLED=true
WTB_AI_REQUIRED_LIVE=true          # live بدون AI مجاز نیست مگر false کنید
WTB_MCP_ENABLED=false
WTB_MCP_URL=https://api.wallex.ir/mcp

# --- زمان‌بندی پایان چالش ---
WTB_STOP_ENTRIES_H=4
WTB_FLATTEN_MIN=45

# --- لاگ/مسیرها (اختیاری) ---
WTB_LOG_DIR=logs
WTB_STATE_PATH=state.json
